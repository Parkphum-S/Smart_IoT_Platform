# Application
APP_NAME=Smart IoT Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Exact frontend origins allowed to access the API
TRUSTED_ORIGINS=[]

# PostgreSQL - replace the example credentials before use
DATABASE_URL=postgresql+asyncpg://smart_iot_app:change_me@127.0.0.1:5432/smart_iot

# Dedicated Alembic connection; do not use this URL in the running application
MIGRATION_DATABASE_URL=postgresql+asyncpg://smart_iot_migrator:change_me@127.0.0.1:5432/smart_iot

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Application secret - generate a random value of at least 32 characters for production
SECRET_KEY=


# Session security
SESSION_ABSOLUTE_LIFETIME_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=300
